<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- تم پنجره اندروید تا زمانی که اولین فریم فلاتر رسم شود (حالت روشن).
         در بیلد ابری همین فایل با splash_bg_color دریافتی از وردپرس بازنویسی میشود. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- تم پنجره پس از شروع پروسه؛ پشت رابط فلاتر قرار میگیرد.
         همرنگ اسپلش است تا هنگام انتقال، فلش سیاه/سفید دیده نشود. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
